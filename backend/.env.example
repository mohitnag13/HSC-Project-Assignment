# Ingestion pipeline configuration. Copy to .env and pass it with
#   docker run --env-file backend/.env ...
# Never commit a real token; prefer SHC_API_TOKEN_FILE with a mounted secret.

# --- SHC Platform API ----------------------------------------------------------------
SHC_API_URL=https://api.mock-shc.com/v1/patients
SHC_API_TOKEN=replace-me
# SHC_API_TOKEN_FILE=/run/secrets/shc_api_token

# --- Files (container paths) -------------------------------------------------------------
INPUT_FILE=/data/input/patients.csv
OUTPUT_DIR=/data/output
# FAILED_RECORDS_FILE=/data/output/failed_records.json

# --- Throughput: the SHC API accepts <= 100 records/request and <= 5 requests/s ------------
BATCH_SIZE=100
MAX_REQUESTS_PER_SECOND=5
RATE_LIMIT_SAFETY_MS=50
CONCURRENCY=2

# --- Fault tolerance ---------------------------------------------------------------------
MAX_RETRIES=5
BACKOFF_BASE_MS=500
BACKOFF_MAX_MS=30000
REQUEST_TIMEOUT_MS=30000
BISECT_ON_400=true

# --- Behaviour & logging ------------------------------------------------------------------
DRY_RUN=false
LOG_LEVEL=info
LOG_FORMAT=json
