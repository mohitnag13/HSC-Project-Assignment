{
  "name": "hsc-backend",
  "version": "1.0.0",
  "private": true,
  "description": "GlobalHealth Corp -> SHC Platform legacy patient data ingestion pipeline (ETL), mock SHC API and migration console API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/main.js",
    "ingest": "tsx src/cli.ts ingest",
    "transform": "tsx src/cli.ts transform",
    "generate": "tsx src/cli.ts generate",
    "mock-api": "tsx src/cli.ts mock-api",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "hsc": "file:.."
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
